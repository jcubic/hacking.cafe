const figlet = require('figlet');
const stdin = require('stdin');
const stdout = require('stdout');
const parse = require('@jcubic/lily');

async function main(...args) {
    const options = await parse(args);
    const font = options.font
    await load_fonts(options.font ? [font] : ['Standard']);
    let message;
    if (!options._.length) {
        message = await stdin.read();
    } else {
        message = options._.join(' ');
    }
    const text = await figlet.text(message, {
        font
    });
    await stdout.writeln(text);
    return 0;
}

async function load_fonts(fonts = ['Standard']) {
    figlet.defaults({ fontPath: 'https://cdn.jsdelivr.net/npm/figlet/fonts' });
    await figlet.preloadFonts(fonts);
}
