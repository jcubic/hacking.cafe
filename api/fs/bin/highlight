#!/bin/js

const stdout = require('stdout');
const fs = require('fs');
const stdin = require('stdin');
const stderr = require('stderr');
const bash = require('bash');
const parse = require('@jcubic/lily');
const $ = require('$');

async function main(...args) {
    const options = await parse(args);
    let content;
    if (!options.lang) {
        await stderr.writeln('Usage: hightlight --lang &lt;langauge&gt; [FILE]');
        return 1;
    }
    if (options._.length === 0) {
        content = await stdin.read();
    } else {
        const filename = await bash.resolve_path(options._[0]);
        content = await fs.readFile(filename, 'utf8');
    }
    await stdout.write(await $.terminal.prism(options.lang, content));
    return 0;
}
