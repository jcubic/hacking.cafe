#!/bin/js

importScripts('https://cdn.jsdelivr.net/npm/brython@3/brython.js');
importScripts('https://cdn.jsdelivr.net/npm/brython@3/brython_stdlib.js');

const parse = require('@jcubic/lily');
const stdout = require('stdout');
const stderr = require('stderr');
const term = require('term');
const bash = require('bash');
const fs = require('fs');

const io = {
    stdout,
    stderr
};

// Brython calls the three bridge functions below synchronously - sys.stdout
// cannot await. A mitty chain is only sent to the main thread when something
// awaits it, so calling io[type].write() and dropping the result would send
// nothing at all. Every call is queued instead, and drain() awaits the queue:
// that is what dispatches the calls, and chaining them keeps them in the order
// Python made them.
let queue = Promise.resolve();

// a call that fails must not hold back the ones behind it, hence the same
// handler on both paths
function enqueue(fn) {
    queue = queue.then(fn, fn);
}

async function drain() {
    try {
        await queue;
    } catch(e) {
        // output that cannot reach the terminal has nowhere left to be reported
    }
}

self.write = function(type, data) {
    enqueue(() => io[type].write(data));
};

self.flush = function(type) {
    enqueue(() => io[type].flush());
};

self.set_prompt = function(prompt) {
    enqueue(() => term.set_prompt(prompt));
};

const python = String.raw`
import sys
import re
import traceback
import javascript
from browser import scope, self, console

class StreamRedirect:
    def __init__(self, stream_name):
        self.stream_name = stream_name
    def write(self, data):
        scope.write(self.stream_name, data)
    def flush(self):
        scope.flush(self.stream_name)

sys.stdout = StreamRedirect("stdout")
sys.stderr = StreamRedirect("stderr")

code = ""

env = {}

def version():
    v = sys.implementation.version
    sys.stdout.write(f"Brython {v[0]}.{v[1]}.{v[2]}\n")

def error(err):
    lines = traceback.format_exception(err);
    return "".join(lines)

def evaluate(code):
    global env
    try:
        ret = eval(code, env)
        if ret != None:
            sys.stdout.write(repr(ret) + "\n")
    except:
        try:
            exec(code, env)
        except Exception as e:
            lines = traceback.format_exception(e)
            err = "".join(lines)
            err = re.sub(r".*(interpreter|evaluate)\n", "", err)
            err = re.sub(r'".*"', '"&lt;stdin&gt;"', err)
            sys.stderr.write(err)

def interpreter(command):
    global code
    try:
        if command.endswith(":"):
            scope.set_prompt("... ")
            code = code + command + "\n"
        elif code != "":
            if command == "":
                scope.set_prompt(">>> ")
                evaluate(code)
                code = ""
            else:
                code = code + command + "\n"
        else:
            evaluate(command)
    except SyntaxError as msg:
        if str(msg) == 'invalid syntax : triple string end not found' or \
            str(msg).startswith('Unbalanced bracket'):
            scope.set_prompt("... ")
            code = code + command
    return javascript.UNDEFINED

self.interpreter = interpreter
self.version = version
self.error  = error

`;

brython({ debug: 1 });

__BRYTHON__.brython_path = 'https://cdn.jsdelivr.net/npm/brython@3.9.0/';

async function run(code, filename = '__internal__') {
    try {
        const output = __BRYTHON__.python_to_js(code);
        eval(output);
        return 0;
    } catch(err) {
        await stderr.write(self.error(err).replace(/blob:[^"]+/, filename));
        return 1;
    }
}


async function main(...args) {
    await term.pause();
    await run(`import sys; sys.argv=${JSON.stringify(args)}`);
    await run(python);
    if (!args.length) {
        return new Promise(async resolve => {
            self.version();
            self.flush('stdout');
            await drain();
            await term.push(async command => {
                self.interpreter(command);
                // the REPL prints per command, so the buffers cannot wait for
                // main() to return the way a script run does
                self.flush('stdout');
                self.flush('stderr');
                await drain();
            }, {
                name: 'python',
                prompt: '>>> ',
                onExit: () => resolve(0)
            });
            await term.resume();
        });
    }
    const options = await parse(args);
    try {
        if (options.c) {
            return await run(options.c, '&lt;string&gt;');
        }
        if (options._.length) {
            const filename = await bash.resolve_path(options._[0]);
            const code = await fs.readFile(filename, 'utf8');
            return await run(code.replace(/^#!.*/, ''), filename);
        }
        await stderr.writeln('usage: python [-c "code"] | [filename]');
        return 0;
    } catch(e) {
        await stderr.writeln(e.message);
        return 1;
    } finally {
        // the queue holds everything Python printed; it has to reach the
        // buffers before they are flushed
        await drain();
        await io.stdout.flush();
        await io.stderr.flush();
        await term.resume();
    }
}
